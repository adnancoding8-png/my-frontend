<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Gray background -->
  <rect width="400" height="300" fill="#d1d5db"/>
  
  <!-- Darker border -->
  <rect width="400" height="300" fill="none" stroke="#9ca3af" stroke-width="2"/>
  
  <!-- Icon placeholder (simple image icon) -->
  <g transform="translate(200, 120)">
    <rect x="-30" y="-25" width="60" height="50" rx="4" fill="#9ca3af"/>
    <circle cx="-15" cy="-10" r="8" fill="#6b7280"/>
    <path d="M -30 10 L -10 -5 L 10 10 L 30 -10 L 30 25 L -30 25 Z" fill="#6b7280"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="200" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="500" fill="#6b7280" text-anchor="middle">
    No Image Available
  </text>
</svg>